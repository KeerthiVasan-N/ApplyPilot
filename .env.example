# ApplyPilot Environment Configuration
# Copy to .env (in this repo) or ~/.applypilot/.env and fill in your values.

# Data directory (profile, resume, DB, generated files). Defaults to ~/.applypilot
# APPLYPILOT_DIR=.

# LLM Provider (pick one)
# LLM_PROVIDER=claude     # Use the Claude Code CLI (`claude -p`, your Claude login) instead of an API key
GEMINI_API_KEY=           # Gemini Flash (recommended, free tier; default model gemini-3.6-flash)
# OPENAI_API_KEY=         # OpenAI (GPT-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name
# LLM_MODEL_FAST=         # Cheaper model for the calls whose output never reaches the resume:
                          # reading the job title, extracting keywords, writing things_to_learn.txt.
                          # The tailoring, keyword-gap and one-page passes stay on LLM_MODEL.
                          # Unset = everything on LLM_MODEL. Example: claude-haiku-4-5-20251001

# tailor-url PDF compiler (optional): tectonic (default if found) or pdflatex (Overleaf's default engine)
# LATEX_COMPILER=tectonic

# Auto-Apply (optional)
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
